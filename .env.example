# Copy to .env, then enter your credential locally. Do not commit .env.
LLM_API_KEY=
# Select a model enabled for your provider/account. No silent model default.
LLM_MODEL=
# OpenAI-compatible Chat Completions base URL, including /v1 if required.
LLM_BASE_URL=https://api.openai.com/v1
# Qwen JSON mode: set false. Leave empty for providers without this parameter.
LLM_ENABLE_THINKING=
